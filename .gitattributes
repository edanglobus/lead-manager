# Force LF for source / config across OSes
*.java       text eol=lf
*.kt         text eol=lf
*.sql        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.properties text eol=lf
*.sh         text eol=lf
Dockerfile   text eol=lf

# Windows-only scripts keep CRLF
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.jar        binary
