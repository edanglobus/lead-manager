{
  "info": {
    "name": "Lead Manager Backend",
    "_postman_id": "8a3e5d9c-1234-4567-8901-abcdef012345",
    "description": "All endpoints currently implemented across slices 1-4 of the Lead Manager backend.\n\n**Setup:**\n1. Boot the backend locally (see `.claude/skills/start-lead-manager-backend/SKILL.md`).\n2. Run the requests in order. The 'Login Alice' and 'Login Bob' requests have test scripts that automatically save their access tokens into collection variables `TOKEN_A` and `TOKEN_B`. The 'Create job' request saves the new job id into `JOB_ID`.\n3. All endpoints expect `Authorization: Bearer {{TOKEN_A}}` (or `{{TOKEN_B}}` for the 'stranger' scenario).\n\n**Slices covered:** 1 (auth), 2 (service categories), 3 (service areas + nearby providers), 4 (job core lifecycle).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "TOKEN_A",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Login Alice' request."
    },
    {
      "key": "TOKEN_B",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Login Bob' request. Use this token to verify the 404-not-403 visibility guard."
    },
    {
      "key": "REFRESH_TOKEN_A",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Login Alice' request."
    },
    {
      "key": "JOB_ID",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Create job' request."
    },
    {
      "key": "JOB_ID_2",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Create second job (for cancel demo)' request."
    },
    {
      "key": "SERVICE_AREA_ID",
      "value": "",
      "type": "string",
      "description": "Set automatically by the 'Create service area' request."
    }
  ],
  "item": [
    {
      "name": "01 - Auth (slice 1)",
      "item": [
        {
          "name": "Register Alice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@test.io\",\n  \"password\": \"correcthorsebatterystaple\",\n  \"displayName\": \"Alice\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Register Bob (the 'stranger')",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@test.io\",\n  \"password\": \"correcthorsebatterystaple\",\n  \"displayName\": \"Bob\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login Alice (auto-saves TOKEN_A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.collectionVariables.set('TOKEN_A', data.accessToken);",
                  "    console.log('TOKEN_A saved');",
                  "}",
                  "if (data.refreshToken) {",
                  "    pm.collectionVariables.set('REFRESH_TOKEN_A', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@test.io\",\n  \"password\": \"correcthorsebatterystaple\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Login Bob (auto-saves TOKEN_B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.collectionVariables.set('TOKEN_B', data.accessToken);",
                  "    console.log('TOKEN_B saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@test.io\",\n  \"password\": \"correcthorsebatterystaple\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Refresh access token (rotates pair)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{BASE_URL}}/auth/refresh",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN_A}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Logout (revokes refresh family)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN_A}}" }
            ],
            "url": {
              "raw": "{{BASE_URL}}/auth/logout",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN_A}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "GET /users/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN_A}}" }],
            "url": {
              "raw": "{{BASE_URL}}/users/me",
              "host": ["{{BASE_URL}}"],
              "path": ["users", "me"]
            }
