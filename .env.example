# ---------------------------------------------------------------------
# Copy this file to .env and fill in real values. The .env file is
# git-ignored. NEVER commit secrets (CLAUDE.md §Secrets Management).
# ---------------------------------------------------------------------

# --- Database (consumed by docker-compose.yml AND application.yml) ---
POSTGRES_DB=leadmanager
POSTGRES_USER=leadmanager
POSTGRES_PORT=5432

# Required. Choose a strong password for local dev; production uses a secrets manager.
DB_PASSWORD=change-me-locally

# Used by the Spring app when it connects to the container above.
DB_URL=jdbc:postgresql://localhost:5432/leadmanager
DB_USERNAME=leadmanager

# --- Server ---
SERVER_PORT=8080

# --- Active profile (local | test | prod) ---
SPRING_PROFILES_ACTIVE=local
