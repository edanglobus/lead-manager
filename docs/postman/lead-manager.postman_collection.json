    {
      "name": "04 - Jobs — error paths (guardrails)",
      "item": [
        {
          "name": "A. Start a CLOSED_PAID job → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('code is JOB_STATE_TRANSITION_NOT_ALLOWED', () => pm.expect(pm.response.json().code).to.eql('JOB_STATE_TRANSITION_NOT_ALLOWED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN_A}}" }],
            "url": {
              "raw": "{{BASE_URL}}/jobs/{{JOB_ID}}/start",
              "host": ["{{BASE_URL}}"],
              "path": ["jobs", "{{JOB_ID}}", "start"]
            }
          },
          "response": []
        },
        {
          "name": "B. Bob fetches Alice's job → 404 (not 403!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('code is RESOURCE_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('RESOURCE_NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN_B}}" }],
            "url": {
              "raw": "{{BASE_URL}}/jobs/{{JOB_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["jobs", "{{JOB_ID}}"]
            },
            "description": "The anti-enumeration guard: Bob (a stranger) cannot tell the difference between 'this id is Alice's' and 'this id does not exist'."
          },
          "response": []
        },
        {
          "name": "C. Create without title → 400",
